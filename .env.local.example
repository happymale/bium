# 이 파일을 복사해서 .env.local 로 이름을 바꾸고, 발급받은 키를 붙여넣으세요.
#
#   console.anthropic.com → API Keys → Create Key
#
# .env.local 은 .gitignore 에 등록돼 있어 깃에 올라가지 않습니다.
# 키가 비어 있으면 앱은 자동으로 목업 응답 모드로 동작합니다.

ANTHROPIC_API_KEY=

# 판별 모델 (미설정 시 claude-opus-5)
#   claude-haiku-4-5  약  9원/장   ← 개발·테스트용
#   claude-sonnet-5   약 27원/장
#   claude-opus-5     약 45원/장   ← 발표·실사용
BIUM_MODEL=

# Google Analytics 4 측정 ID (G-XXXXXXXXXX). 비우면 GA 완전 비활성.
VITE_GA_MEASUREMENT_ID=

# Supabase (선택). 비우면 localStorage 로만 동작합니다.
#   Supabase 대시보드 → Settings → API Keys
#   ⚠ publishable(구 anon) 키만. sb_secret / service_role 은 브라우저에 넣으면 안 됩니다.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# 운영자용 계측 점검 화면(#/metrics)을 배포본에서도 열려면 1 로 두세요.
# 비어 있으면 라우트 자체가 생기지 않습니다 — 사용자에게 지표를 보여주면
# 행동이 바뀌어 측정이 오염됩니다. 개발 중에는 값과 무관하게 항상 열립니다.
VITE_SHOW_METRICS=
